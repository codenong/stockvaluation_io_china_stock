# StockValuation.io local Docker configuration.
# Copy this file to .env and keep real values out of source control.

# Postgres
POSTGRES_USER=postgres
POSTGRES_DB=stockvaluation_io
POSTGRES_PASSWORD=CHANGE_ME

# Required local secrets
DEFAULT_PASSWORD=CHANGE_ME

# Local service defaults
CURRENCY_PROVIDER_BASE_URL=https://api.frankfurter.dev/v2

# SEC EDGAR public data access.
# Required for live SEC primary-filing financial ingestion. Use a declared
# organization/app name and contact email as requested by SEC fair-access
# guidance. Leave blank or CHANGE_ME to disable live SEC and use explicit
# Yahoo-normalized fallback when applicable.
SEC_USER_AGENT=CHANGE_ME
SEC_EDGAR_ENABLED=true
SEC_EDGAR_REQUESTS_PER_SECOND=5
SEC_EDGAR_CACHE_TTL_SECONDS=900

DEFAULT_USERNAME=local_admin
DEFAULT_FIRSTNAME=Local
DEFAULT_LASTNAME=Admin
DEFAULT_CONTACT=0000000000
